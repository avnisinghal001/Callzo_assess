server {
    listen 8080;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Browsers cannot resolve "mock-api", so nginx forwards /api to it: one origin, no CORS.
    # Docker's DNS plus a variable means nginx starts, and recovers, even if the API restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api ${API_URL};

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_set_header Host $proxy_host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }

    # Hashed file names: safe to keep for a year. index.html is always revalidated.
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri /index.html;
    }
}
