# Optional: `docker compose up` works without this file. Copy it to `.env` (gitignored) to change
# anything. Every value below is for development only. Put no comments after values.

POSTGRES_PASSWORD=dev-only-password

# Secrets. To rotate one: put the old value in *_PREVIOUS, set the new one, deploy, and clear
# *_PREVIOUS once every client has switched.
WEBHOOK_SECRET=callzo_test_secret_change_me
WEBHOOK_SECRET_PREVIOUS=
API_KEY=dev-only-api-key-change-me
API_KEY_PREVIOUS=
ADMIN_API_KEY=dev-only-admin-key-change-me
ADMIN_API_KEY_PREVIOUS=

# Opens the console with no sign-in. Only on localhost or behind an identity-aware proxy.
CONSOLE_OPEN_ACCESS=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,gateway

# Off in production.
ENABLE_SANDBOX=true
DOCS_ENABLED=true

DEFAULT_MONTHLY_CAP_MINUTES=200
LOG_LEVEL=INFO

# Connection pool, per API replica. Replicas x DB_POOL_MAX_SIZE + workers must fit max_connections.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=8
DB_POOL_MAX_WAITING=32
DB_POOL_TIMEOUT=5

# How long before a crashed worker's event is taken over.
CLAIM_LEASE_SECONDS=60
